{
  "name": "type-nudge",
  "productName": "TypeNudge",
  "version": "0.1.0",
  "description": "An offline plain-text desktop editor",
  "author": "Keresztes Zsolt <https://kereszteszsolt.hu>",
  "license": "Apache-2.0",
  "private": true,
  "main": ".vite/build/main.js",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "allowScripts": {
    "better-sqlite3": false
  },
  "scripts": {
    "dev": "electron-forge start",
    "start": "electron-forge start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:desktop": "playwright test",
    "benchmark:prediction": "node scripts/benchmark-prediction.mjs",
    "benchmark:import": "node scripts/benchmark-import.mjs",
    "package": "electron-forge package"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "electron": "44.9.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
